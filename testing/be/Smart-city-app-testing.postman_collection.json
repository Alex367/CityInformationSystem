		{
			"name": "city, empty city",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const responseData = pm.response.json();",
							"",
							"pm.test(\"Status code is 400\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"pm.test(\"Response structure, characters\", function () {",
							"    pm.expect(responseData[0]).to.have.property('status');",
							"    pm.expect(responseData[0]).to.have.property('message');",
							"    pm.expect(responseData[0]).to.have.property('timeStamp');",
							"",
							"    let arr = [",
							"        \"City must be between 2 and 45 characters\",",
							"        \"City can not be null or empty\", ",
							"        \"City must contain only letters, spaces, hyphens, or apostrophes\"];",
							"",
							"    pm.expect(responseData[0].message).to.contain.oneOf(arr);",
							"",
							"});",
							"",
							"pm.test(\"Response structure, letters\", function () {",
							"    pm.expect(responseData[1]).to.have.property('status');",
							"    pm.expect(responseData[1]).to.have.property('message');",
							"    pm.expect(responseData[1]).to.have.property('timeStamp');",
							"});",
							"",
							"pm.test(\"Response structure, empty\", function () {",
							"    pm.expect(responseData[2]).to.have.property('status');",
							"    pm.expect(responseData[2]).to.have.property('message');",
							"    pm.expect(responseData[2]).to.have.property('timeStamp');",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
